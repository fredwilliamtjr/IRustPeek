{
  "name": "irustpeek",
  "version": "0.1.7",
  "description": "Catálogo sincronizável de endereços RustDesk para macOS, Windows e Linux.",
  "main": "src/main.js",
  "author": "Fred William",
  "license": "TBD",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac:dir": "electron-builder --mac dir",
    "build:mac:universal": "electron-builder --mac dir --universal",
    "build:win": "electron-builder --win",
    "build:win:dir": "electron-builder --win dir",
    "build:win:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux",
    "build:linux:dir": "electron-builder --linux dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.fredwilliam.irustpeek",
    "productName": "IRustPeek",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Agenda sincronizável de endereços RustDesk",
      "maintainer": "Fred William",
      "executableName": "irustpeek",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    }
  },
  "homepage": "https://github.com/fredwilliamtjr/IRustPeek"
}
